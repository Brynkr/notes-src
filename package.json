{
  "name": "notes-app",
  "version": "0.4.0",
  "private": true,
  "description": "Git-backed Markdown notes: one small server that serves a web UI and syncs a folder of notes through git.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "dev": "node scripts/build.mjs && node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "test:ui": "node scripts/build.mjs && node tests/ui/smoke.mjs && node tests/ui/features.mjs && node tests/ui/offline.mjs && node tests/ui/appearance.mjs && node tests/ui/ide.mjs && node tests/ui/extras.mjs",
    "package": "node scripts/package.mjs",
    "icons": "node scripts/icons.mjs",
    "exe": "node scripts/build-exe.mjs",
    "test:exe": "node scripts/test-exe.mjs",
    "release": "node scripts/package.mjs && node scripts/build-exe.mjs && node scripts/test-exe.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.2",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.2",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-minimap": "^0.5.2",
    "@types/node": "^26.6.11",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "puppeteer-core": "^25.19.0",
    "rcedit": "^5.0.2",
    "typescript": "^7.0.2"
  }
}
